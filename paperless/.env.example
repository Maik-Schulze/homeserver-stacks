# Copy to .env and fill in the secrets
# Generate both with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PAPERLESS_SECRET_KEY=
PAPERLESS_DBPASS=

# Tailscale address of the home server
PAPERLESS_BIND=100.70.136.107

PAPERLESS_URL=https://paperless.maikschulze.de
# Only nginx on the VPS (Tailscale address) talks to Paperless
PAPERLESS_TRUSTED_PROXIES=100.91.52.35
PAPERLESS_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO", "https"]

PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu+eng
# Reject files that are already in the library instead of storing them twice
PAPERLESS_CONSUMER_DELETE_DUPLICATES=true

# Files in consume and data belong to maik on the host
USERMAP_UID=1000
USERMAP_GID=1000
